# Server-only values. Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=replace-with-a-generated-local-secret
AUTH_URL=http://localhost:3000
AUTH_ISSUER=http://127.0.0.1:8080/realms/cloudops
AUTH_CLIENT_ID=cloudops-web
AUTH_CLIENT_SECRET=replace-with-the-keycloak-client-secret
CLOUDOPS_API_URL=http://127.0.0.1:8000
CLOUDOPS_ROLE_ASSIGNMENTS={"http://127.0.0.1:8080/realms/cloudops|11111111-1111-4111-8111-111111111111":["engineer"],"http://127.0.0.1:8080/realms/cloudops|22222222-2222-4222-8222-222222222222":["approver"]}
