# Merge into the private AWS config after administrator approval. Do not store MFA codes.
[profile cloudops-ec2-demo-session]
role_arn = arn:aws:iam::294665681966:role/cloudops-ec2-demo-deploy
source_profile = cloudops-iam
role_session_name = cloudops-ec2-demo
duration_seconds = 3600
region = ca-central-1
mfa_serial = arn:aws:iam::294665681966:mfa/cloudops-dev-totp

[profile cloudops-ec2-demo-deploy]
credential_process = aws configure export-credentials --profile cloudops-ec2-demo-session --format process
region = ca-central-1
