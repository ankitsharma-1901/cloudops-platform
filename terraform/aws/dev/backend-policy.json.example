{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListStateAndWorkspacePrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<STATE_BUCKET>",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["cloudops/development/*", "cloudops/workspaces/*"]
        }
      }
    },
    {
      "Sid": "ReadWriteDevelopmentState",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::<STATE_BUCKET>/cloudops/development/terraform.tfstate"
    },
    {
      "Sid": "AcquireAndReleaseDevelopmentLock",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::<STATE_BUCKET>/cloudops/development/terraform.tfstate.tflock"
    }
  ]
}
