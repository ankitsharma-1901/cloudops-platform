{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegionalNetworkReads",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcs",
        "ec2:DescribeVpcAttribute",
        "ec2:DescribeSubnets",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ca-central-1"
        }
      }
    },
    {
      "Sid": "CreateTaggedNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:CreateSubnet",
        "ec2:CreateInternetGateway",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:AuthorizeSecurityGroupEgress"
      ],
      "Resource": [
        "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:vpc/*",
        "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:subnet/*",
        "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:internet-gateway/*",
        "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:route-table/*",
        "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:security-group/*",
        "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:security-group-rule/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ca-central-1",
          "aws:RequestTag/Project": "CloudOps",
          "aws:RequestTag/Environment": "development",
          "aws:RequestTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "UseOwnedParentsForCreation",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:AuthorizeSecurityGroupEgress"
      ],
      "Resource": [
        "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:vpc/*",
        "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ca-central-1",
          "ec2:ResourceTag/Project": "CloudOps",
          "ec2:ResourceTag/Environment": "development",
          "ec2:ResourceTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "ManageOwnedNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:ModifyVpcAttribute",
        "ec2:DeleteVpc",
        "ec2:ModifySubnetAttribute",
        "ec2:DeleteSubnet",
        "ec2:AttachInternetGateway",
        "ec2:DetachInternetGateway",
        "ec2:DeleteInternetGateway",
        "ec2:DeleteRouteTable",
        "ec2:CreateRoute",
        "ec2:DeleteRoute",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:DeleteSecurityGroup",
        "ec2:RevokeSecurityGroupEgress"
      ],
      "Resource": [
        "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:vpc/*",
        "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:subnet/*",
        "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:internet-gateway/*",
        "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:route-table/*",
        "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ca-central-1",
          "ec2:ResourceTag/Project": "CloudOps",
          "ec2:ResourceTag/Environment": "development",
          "ec2:ResourceTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "TagNetworkOnlyAtCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:vpc/*",
        "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:subnet/*",
        "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:internet-gateway/*",
        "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:route-table/*",
        "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:security-group/*",
        "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:security-group-rule/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ca-central-1",
          "aws:RequestTag/Project": "CloudOps",
          "aws:RequestTag/Environment": "development",
          "aws:RequestTag/ManagedBy": "Terraform",
          "ec2:CreateAction": [
            "CreateVpc",
            "CreateSubnet",
            "CreateInternetGateway",
            "CreateRouteTable",
            "CreateSecurityGroup",
            "AuthorizeSecurityGroupEgress"
          ]
        }
      }
    }
  ]
}
