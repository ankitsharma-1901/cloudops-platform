{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegionalComputeReads",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceAttribute",
        "ec2:DescribeInstanceCreditSpecifications",
        "ec2:DescribeVolumes",
        "ec2:DescribeImages",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeInstanceStatus"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ca-central-1"
        }
      }
    },
    {
      "Sid": "ReadPublicAMI",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:ca-central-1::parameter/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ca-central-1"
        }
      }
    },
    {
      "Sid": "LaunchApprovedImage",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:ca-central-1::image/<APPROVED_AMI_ID>",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ca-central-1"
        }
      }
    },
    {
      "Sid": "LaunchSmallIMDSv2Instance",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ca-central-1",
          "aws:RequestTag/Project": "CloudOps",
          "aws:RequestTag/Environment": "development",
          "aws:RequestTag/ManagedBy": "Terraform",
          "ec2:InstanceType": "t3.micro",
          "ec2:MetadataHttpTokens": "required"
        },
        "ArnEquals": {
          "ec2:InstanceProfile": "arn:aws:iam::<ACCOUNT_ID>:instance-profile/cloudops-dev-ec2-ssm"
        }
      }
    },
    {
      "Sid": "LaunchEncryptedRootVolume",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:volume/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ca-central-1",
          "aws:RequestTag/Project": "CloudOps",
          "aws:RequestTag/Environment": "development",
          "aws:RequestTag/ManagedBy": "Terraform",
          "ec2:VolumeType": "gp3"
        },
        "Bool": {
          "ec2:Encrypted": "true"
        },
        "NumericLessThanEquals": {
          "ec2:VolumeSize": "8"
        }
      }
    },
    {
      "Sid": "LaunchWithOwnedNetwork",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:subnet/*",
        "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ca-central-1",
          "ec2:ResourceTag/Project": "CloudOps",
          "ec2:ResourceTag/Environment": "development",
          "ec2:ResourceTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "LaunchNetworkInterface",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:network-interface/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ca-central-1"
        }
      }
    },
    {
      "Sid": "TagComputeOnlyAtLaunch",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:instance/*",
        "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ca-central-1",
          "aws:RequestTag/Project": "CloudOps",
          "aws:RequestTag/Environment": "development",
          "aws:RequestTag/ManagedBy": "Terraform",
          "ec2:CreateAction": "RunInstances"
        }
      }
    },
    {
      "Sid": "TerminateOwnedInstance",
      "Effect": "Allow",
      "Action": "ec2:TerminateInstances",
      "Resource": "arn:aws:ec2:ca-central-1:<ACCOUNT_ID>:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ca-central-1",
          "ec2:ResourceTag/Project": "CloudOps",
          "ec2:ResourceTag/Environment": "development",
          "ec2:ResourceTag/ManagedBy": "Terraform"
        }
      }
    },
    {
      "Sid": "ReadSSMReadiness",
      "Effect": "Allow",
      "Action": "ssm:DescribeInstanceInformation",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ca-central-1"
        }
      }
    }
  ]
}
