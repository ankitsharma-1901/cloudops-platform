# FastAPI verifies API access tokens independently of the Next.js session.
OIDC_ISSUER=http://127.0.0.1:8080/realms/cloudops
OIDC_AUDIENCE=cloudops-api
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/cloudops/protocol/openid-connect/certs
OIDC_ALLOWED_ALGORITHMS=RS256
# Keycloak 26 uses JWT for the signed access-token header type.
OIDC_ACCESS_TOKEN_TYPES=JWT
CLOUDOPS_ROLE_ASSIGNMENTS={"http://127.0.0.1:8080/realms/cloudops|11111111-1111-4111-8111-111111111111":["engineer"],"http://127.0.0.1:8080/realms/cloudops|22222222-2222-4222-8222-222222222222":["approver"]}
